# Database (same credentials as stock-snapshots)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Reddit (script app at https://www.reddit.com/prefs/apps — read-only, no username/password needed)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=stock-recommendations/1.0 by /u/yourname
