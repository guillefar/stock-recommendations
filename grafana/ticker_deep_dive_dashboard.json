                      "rawQuery": true,
                      "rawSql": "SELECT UNIX_TIMESTAMP(pc.as_of_date) AS time_sec,\n  t.symbol AS metric,\n  pc.price AS value\nFROM price_checks pc\nJOIN tickers t ON pc.ticker_id=t.id\nWHERE t.symbol IN ($ticker) AND $__timeFilter(pc.as_of_date)\nORDER BY time_sec"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
