    "panel-8": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "cfadv004ogglcf"
                    },
                    "group": "mysql",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT r.generated_at AS `called at`,\n  t.symbol,\n  r.action,\n  ROUND(r.confidence*100,0) AS `confidence %`,\n  CAST(JSON_EXTRACT(r.technical,'$.price') AS DECIMAL(12,2)) AS `entry price`,\n  o.verdict AS `30d verdict`,\n  ROUND(100*o.forward_return,1) AS `30d return %`,\n  LEFT(r.reasoning, 200) AS reasoning\nFROM recommendations r\nJOIN tickers t ON r.ticker_id=t.id\nLEFT JOIN recommendation_outcomes o\n  ON o.recommendation_id=r.id AND o.horizon_days=30\nWHERE t.symbol IN ($ticker) AND $__timeFilter(r.generated_at)\nORDER BY r.generated_at DESC"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Every recommendation for the selection in range (newest first) with its 30-day grade. Empty verdict = the call hasn't matured yet or no exit price exists for its window.",
        "id": 8,
        "links": [],
        "title": "Call history",
        "vizConfig": {
          "group": "table",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "custom": {
                  "align": "left",
                  "cellOptions": {
                    "type": "auto"
                  },
                  "filterable": true,
