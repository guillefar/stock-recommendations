                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              },
              "overrides": [
                {
                  "matcher": {
                    "id": "byName",
                    "options": "action"
                  },
                  "properties": [
                    {
                      "id": "mappings",
                      "value": [
                        {
                          "type": "value",
                          "options": {
                            "BUY": {
                              "color": "green",
                              "index": 0
                            }
                          }
                        },
                        {
                          "type": "value",
                          "options": {
                            "SELL": {
                              "color": "red",
                              "index": 1
                            }
                          }
                        },
