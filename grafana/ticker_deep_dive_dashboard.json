    {
      "kind": "AnnotationQuery",
      "spec": {
        "builtIn": false,
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Action flips",
        "filter": {
          "exclude": false,
          "ids": [
            5
          ]
        },
        "query": {
          "datasource": {
            "name": "cfadv004ogglcf"
          },
          "group": "mysql",
          "kind": "DataQuery",
          "spec": {
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT UNIX_TIMESTAMP(r2.generated_at) AS time,\n  CONCAT(t.symbol, ': ', r1.action, ' → ', r2.action, ' (conf ', ROUND(r2.confidence*100, 0), '%)') AS text,\n  CONCAT_WS(',', t.symbol, r2.action) AS tags\nFROM recommendations r2\nJOIN recommendations r1\n  ON r1.ticker_id = r2.ticker_id\n AND r1.generated_at = (\n   SELECT MAX(r3.generated_at) FROM recommendations r3\n   WHERE r3.ticker_id = r2.ticker_id AND r3.generated_at < r2.generated_at\n )\n AND r1.action <> r2.action\nJOIN tickers t ON t.id = r2.ticker_id\nWHERE t.symbol IN ($ticker) AND $__timeFilter(r2.generated_at)\nORDER BY time"
          },
          "version": "v0"
        }
      }
    }
  ],
  "cursorSync": "Off",
  "editable": true,
  "elements": {
    "panel-1": {
