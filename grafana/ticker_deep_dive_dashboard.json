                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "cfadv004ogglcf"
                    },
                    "group": "mysql",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT ROUND(100*SUM(o.verdict='CORRECT')/\n  NULLIF(SUM(o.verdict IN('CORRECT','INCORRECT')),0),0) AS v\nFROM recommendation_outcomes o\nJOIN tickers t ON o.ticker_id=t.id\nWHERE o.horizon_days=30 AND t.symbol IN ($ticker)\n  AND $__timeFilter(o.generated_at)"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
