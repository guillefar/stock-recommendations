                      "name": "cfadv004ogglcf"
                    },
                    "group": "mysql",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT CONCAT(o.horizon_days,'d') AS horizon,\n  COUNT(*) AS total,\n  SUM(o.verdict='CORRECT')   AS correct,\n  SUM(o.verdict='INCORRECT') AS incorrect,\n  SUM(o.verdict='NEUTRAL')   AS neutral,\n  ROUND(100*SUM(o.verdict='CORRECT')/\n    NULLIF(SUM(o.verdict IN('CORRECT','INCORRECT')),0),0) AS `hit rate %`,\n  ROUND(100*AVG(o.forward_return),1) AS `avg return %`\nFROM recommendation_outcomes o\nJOIN tickers t ON o.ticker_id=t.id\nWHERE t.symbol IN ($ticker) AND $__timeFilter(o.generated_at)\nGROUP BY o.horizon_days\nORDER BY o.horizon_days"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
