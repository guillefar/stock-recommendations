    "panel-1": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "cfadv004ogglcf"
                    },
                    "group": "mysql",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT\n  t.symbol,\n  GROUP_CONCAT(DISTINCT s.status) AS phase,\n  r.action,\n  ROUND(r.confidence * 100, 0) AS `confidence %`,\n  CAST(JSON_EXTRACT(r.technical, '$.price') AS DECIMAL(12,2)) AS `entry price`,\n  LEFT(r.reasoning, 200) AS reasoning,\n  hr.`hit rate %` AS `ticker hit rate %`,\n  hr.decided AS `graded calls`\nFROM recommendations r\nJOIN tickers t ON r.ticker_id = t.id\nLEFT JOIN v_ticker_status_multi s ON s.ticker_id = t.id\nLEFT JOIN (\n  SELECT ticker_id,\n    ROUND(100*SUM(verdict='CORRECT')/NULLIF(SUM(verdict IN('CORRECT','INCORRECT')),0),0) AS `hit rate %`,\n    SUM(verdict IN('CORRECT','INCORRECT')) AS decided\n  FROM recommendation_outcomes\n  WHERE horizon_days = 30\n  GROUP BY ticker_id\n) hr ON hr.ticker_id = t.id\nWHERE r.generated_at = (\n  SELECT MAX(r2.generated_at) FROM recommendations r2 WHERE r2.ticker_id = r.ticker_id\n)\nGROUP BY r.id, t.symbol, r.action, r.confidence, r.reasoning, r.technical, hr.`hit rate %`, hr.decided\nORDER BY FIELD(r.action,'BUY','SELL','AVOID','WATCH','HOLD'), r.confidence DESC, t.symbol"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "The most recent recommendation for every active ticker (not scoped by the time picker). 'ticker hit rate %' is that ticker's own historical 30-day hit rate; 'graded calls' is its sample size. Click a symbol to open its deep-dive dashboard (requires replacing DEEP_DIVE_UID in the data link with your Grafana uid for the deep-dive dashboard — see the how-to-read panel).",
        "id": 1,
        "links": [],
        "title": "Latest call per ticker",
