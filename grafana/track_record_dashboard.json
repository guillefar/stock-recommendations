    "panel-6": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "cfadv004ogglcf"
                    },
                    "group": "mysql",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT\n  COALESCE(NULLIF(t.sector_disp,''),'(unknown)') AS sector,\n  COUNT(*)                    AS total,\n  SUM(o.verdict='CORRECT')    AS correct,\n  SUM(o.verdict='INCORRECT')  AS incorrect,\n  SUM(o.verdict='NEUTRAL')    AS neutral,\n  ROUND(100*SUM(o.verdict='CORRECT')/\n    NULLIF(SUM(o.verdict IN('CORRECT','INCORRECT')),0),0) AS `hit rate %`\nFROM recommendation_outcomes o\nJOIN tickers t ON o.ticker_id=t.id\nWHERE o.horizon_days=7 AND $__timeFilter(o.generated_at)\nGROUP BY COALESCE(NULLIF(t.sector_disp,''),'(unknown)')\nHAVING SUM(o.verdict IN('CORRECT','INCORRECT')) >= 10\nORDER BY `hit rate %` DESC, total DESC"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Which sectors the model reads well. Sectors with fewer than 10 decided calls are hidden. '(unknown)' is mostly ETFs / non-US tickers with no sector metadata.",
        "id": 6,
        "links": [],
        "title": "Hit rate by sector",
