    "panel-7": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "cfadv004ogglcf"
                    },
                    "group": "mysql",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT\n  CASE\n    WHEN rsi IS NULL THEN '6 Unknown'\n    WHEN rsi < 30    THEN '1 Oversold (<30)'\n    WHEN rsi < 45    THEN '2 Weak (30-45)'\n    WHEN rsi < 55    THEN '3 Neutral (45-55)'\n    WHEN rsi < 70    THEN '4 Strong (55-70)'\n    ELSE                  '5 Overbought (70+)'\n  END AS `RSI band`,\n  COUNT(*)                  AS total,\n  SUM(verdict='CORRECT')    AS correct,\n  SUM(verdict='INCORRECT')  AS incorrect,\n  SUM(verdict='NEUTRAL')    AS neutral,\n  ROUND(100*SUM(verdict='CORRECT')/\n    NULLIF(SUM(verdict IN('CORRECT','INCORRECT')),0),0) AS `hit rate %`\nFROM (\n  SELECT o.verdict,\n    CAST(JSON_EXTRACT(r.technical,'$.rsi') AS DECIMAL(6,2)) AS rsi\n  FROM recommendation_outcomes o\n  JOIN recommendations r ON o.recommendation_id=r.id\n  WHERE o.horizon_days=30 AND $__timeFilter(o.generated_at)\n) z\nGROUP BY `RSI band`\nORDER BY `RSI band`"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Outcomes bucketed by the ticker's RSI when the call was made \u2014 surfaces the technical regime behind correct calls.",
        "id": 7,
        "links": [],
        "title": "Hit rate by RSI band (at call time, 30d)",
        "vizConfig": {
