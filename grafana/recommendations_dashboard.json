    "panel-1": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "cfadv004ogglcf"
                    },
                    "group": "mysql",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT\n  t.symbol,\n  r.action,\n  ROUND(r.confidence * 100, 0) AS `confidence %`,\n  DATE(r.generated_at) AS `date`,\n  LEFT(r.reasoning, 250) AS reasoning\nFROM recommendations r\nJOIN tickers t ON r.ticker_id = t.id\nJOIN v_ticker_status_multi s ON s.ticker_id = t.id AND s.status = 'HOLDING'\nWHERE DATE(r.generated_at) = (SELECT MAX(DATE(generated_at)) FROM recommendations)\nORDER BY r.confidence DESC, t.symbol"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Latest recommendation for stocks currently held",
        "id": 1,
        "links": [],
        "title": "Holdings — Latest Recommendations",
