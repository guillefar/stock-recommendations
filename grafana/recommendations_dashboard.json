                    "group": "mysql",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "time_series",
                      "rawQuery": true,
                      "rawSql": "SELECT\n  UNIX_TIMESTAMP(r.generated_at) AS time_sec,\n  t.symbol AS metric,\n  r.confidence AS value\nFROM recommendations r\nJOIN tickers t ON r.ticker_id = t.id\nWHERE $__timeFilter(r.generated_at)\nORDER BY r.generated_at, t.symbol"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
